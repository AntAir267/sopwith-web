diff --git a/src/video.c b/src/video.c
index 1a68e5f..4bbd5a1 100644
--- a/src/video.c
+++ b/src/video.c
@@ -1,3 +1,4 @@
+// Modified 2026-10 by Anthony Airdo for the web build (sopwith-web).
 //
 // Copyright(C) 2001-2005 Simon Howard
 //
@@ -16,6 +17,7 @@
 #include <stdint.h>
 
 #include "video.h"
+#include "swmain.h"
 
 // this should be in a header somewhere
 #define SBAR_HGHT 19
@@ -40,6 +42,72 @@ unsigned int vid_pitch;
 
 int keysdown[NUM_KEYS];
 
+// sopwith-web: which way the plane faces, +1 right or -1 left. Pointing straight up or down,
+// it's the way a pull-up would take it (by whether the plane is flipped).
+static int Facing(OBJECTS *ob)
+{
+	if (ob->ob_angle == ANGLES / 4 || ob->ob_angle == 3 * ANGLES / 4) {
+		return ob->ob_orient ? -1 : 1;
+	}
+	return ob->ob_angle < ANGLES / 4 || ob->ob_angle > 3 * ANGLES / 4 ? 1 : -1;
+}
+
+// sopwith-web: arrow-key flying, relative to the screen. Up raises the nose toward the sky and
+// Down points it at the ground, whichever way the plane faces: the turn is picked when the key
+// goes down and kept while it's held, so holding Up still loops. Left and Right are throttle:
+// the arrow the plane is flying toward speeds up, the other slows down. After steering with the
+// arrows, the plane rolls right side up by itself once no pitch arrow is held (until the classic
+// pull up/down or flip keys are used). It all turns into the game's own commands (pull up/down,
+// accelerate/decelerate, flip), worked out from the plane as it is before this tic's move.
+// classic = the commands from the other keys this tic.
+static int ArrowKeys(int classic)
+{
+	static int held, turn;       // pitch arrow held (+1 up, -1 down), latched turn (+1 = counterclockwise)
+	static bool upright;         // roll right side up when no pitch arrow is held
+	OBJECTS *ob = consoleplayer;
+	int c = 0, pitch, push, side;
+
+	if (ob == NULL || ob->ob_type != PLANE) {
+		return 0;
+	}
+
+	pitch = !keysdown[KEY_CLIMB] == !keysdown[KEY_DIVE] ? 0 : keysdown[KEY_CLIMB] ? 1 : -1;
+	push = !keysdown[KEY_LEFTWARD] == !keysdown[KEY_RIGHTWARD] ? 0 : keysdown[KEY_RIGHTWARD] ? 1 : -1;
+
+	if (classic & (K_FLAPU | K_FLAPD | K_FLIP)) {
+		upright = false;
+	}
+
+	if (pitch != held || ob->ob_athome) {
+		held = pitch;
+		turn = pitch * Facing(ob);
+	}
+	if (turn) {
+		// Pull up turns counterclockwise unless the plane is flipped
+		// (in Harry keys mode it always does).
+		bool flapu_ccw = !ob->ob_orient || conf_harrykeys;
+		c |= (turn > 0) == flapu_ccw ? K_FLAPU : K_FLAPD;
+		upright = true;
+	} else if (upright && !(classic & (K_FLAPU | K_FLAPD))
+	        && (ob->ob_state == FLYING || ob->ob_state == WOUNDED)
+	        && !ob->ob_athome && !ob->ob_home) {
+		// (A flip would also cancel flying home.)
+		// Clearly facing one way (not straight up or down) and
+		// upside down for it: roll over.
+		side = ob->ob_angle % (ANGLES / 2) == ANGLES / 4 ? 0
+		     : ob->ob_angle < ANGLES / 4 || ob->ob_angle > 3 * ANGLES / 4 ? 1 : -1;
+		if ((side < 0 && !ob->ob_orient) || (side > 0 && ob->ob_orient)) {
+			c |= K_FLIP;
+		}
+	}
+
+	if (push) {
+		c |= push == Facing(ob) ? K_ACCEL : K_DEACC;
+	}
+
+	return c;
+}
+
 int Vid_GetGameKeys(void)
 {
 	int i, c = 0;
@@ -92,6 +160,8 @@ int Vid_GetGameKeys(void)
 		c |= K_STARBURST;
 	}
 
+	c |= ArrowKeys(c);
+
 	// clear bits in key array
 	for (i=0; i<NUM_KEYS; ++i) {
 		keysdown[i] &= ~KEYDOWN_WAS_PRESSED;
