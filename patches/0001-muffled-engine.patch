 #define TIMER_FREQ 1193280
 
+// sopwith-web: the muffled engine. The engine drone is a 22-42 Hz square wave, and the tinny filter
+// passes only its 1.5-6 kHz harmonics, which makes a constant rasp. Muffled, it skips the tinny
+// filter and goes through a 1 kHz low-pass instead (like the TEREP port's muffled engine), at a
+// level about 4 dB(A) under the original. Every other sound is unchanged.
+#define MUFFLE_CUTOFF_FREQ 1000 /* hz */
+#define MUFFLE_GAIN 0.27
+
+struct biquad {
+	float b0, b1, b2, a1, a2, x1, x2, y1, y2;
+};
+
 struct filter {
 	float *kernel;
 	size_t kernel_len;
@@ -40,6 +52,9 @@ struct filter {
 };
 
 bool snd_tinnyfilter = 1;
+bool snd_muffle_engine = 1;
+static bool engine_tone = false;
+static struct biquad muffle_filter;
 static bool sound_initted = false;
 static bool speaker_on = false;
 static SDL_AudioDeviceID audio_dev;
@@ -65,6 +80,32 @@ static float FilterNext(struct filter *f, float sample)
 	return accum;
 }
 
+static void MakeBiquadLowPass(struct biquad *f, float sample_rate,
+                              float cutoff)
+{
+	float w = 2 * M_PI * cutoff / sample_rate, q = 0.707;
+	float al = sin(w) / (2 * q), c = cos(w), a0 = 1 + al;
+
+	f->b0 = (1 - c) / 2 / a0;
+	f->b1 = (1 - c) / a0;
+	f->b2 = f->b0;
+	f->a1 = -2 * c / a0;
+	f->a2 = (1 - al) / a0;
+	f->x1 = f->x2 = f->y1 = f->y2 = 0;
+}
+
+static float BiquadNext(struct biquad *f, float x)
+{
+	float y = f->b0 * x + f->b1 * f->x1 + f->b2 * f->x2
+	        - f->a1 * f->y1 - f->a2 * f->y2;
+
+	f->x2 = f->x1;
+	f->x1 = x;
+	f->y2 = f->y1;
+	f->y1 = y;
+	return y;
+}
+
 static float SincFunction(int idx, int kernel_len, float freq)
 {
