 			sample = OversampledSquareWave(i + lasttime);
 		}
 
-		sample = FilterNext(&tinny_filter, sample);
+		// Both filters run all the time (on silence when not in use), so
+		// switching between them doesn't click.
+		sample = FilterNext(&tinny_filter, muffle ? 0 : sample)
+		       + MUFFLE_GAIN * BiquadNext(&muffle_filter,
+		                                  muffle ? sample : 0);
 		stream[i] = (signed int) (sample * VOLUME);
 	}
 
